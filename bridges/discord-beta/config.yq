.homeserver.address = "http://synapse:8008" |
.homeserver.domain = "hub.home.arpa" |
.appservice.address = "http://discord-beta:29334" |
.appservice.hostname = "0.0.0.0" |
.appservice.port = 29334 |
.appservice.database.type = "postgres" |
.appservice.database.uri = strenv(DB_URI) |
.appservice.database.max_open_conns = 5 |
.appservice.id = "discord_beta" |
.appservice.bot.username = "discordbot_beta" |
.appservice.bot.displayname = "Discord (beta)" |
.appservice.bot.avatar = "mxc://hub.home.arpa/vhUOzyIPsahjXUQYovunUfaH" |
.bridge.username_template = "discord_beta_{{.}}" |
.bridge.displayname_template = "{{if .Webhook}}Webhook{{else}}{{or .GlobalName .Username}}{{if .Bot}} (bot){{end}}{{end}} [beta]" |
.bridge.channel_name_template = "[beta] {{if or (eq .Type 3) (eq .Type 4)}}{{.Name}}{{else}}#{{.Name}}{{end}}" |
.bridge.guild_name_template = "[beta] {{.Name}}" |
.bridge.command_prefix = "!dc-beta" |
.bridge.management_room_text.welcome = "Hello, I'm the Discord bridge for the account beta." |
.bridge.federate_rooms = false |
.bridge.mute_channels_on_create = true |
.bridge.double_puppet_server_map = {} |
.bridge.login_shared_secret_map = {"hub.home.arpa": "as_token:" + strenv(DP_TOKEN)} |
.bridge.backfill.forward_limits.initial = {"dm": 20, "channel": 0, "thread": 0} |
.bridge.backfill.forward_limits.missed = {"dm": 50, "channel": 20, "thread": 0} |
.bridge.encryption.allow = false |
.bridge.permissions = {"@piadmin:hub.home.arpa": "admin"} |
.logging.min_level = "info" |
.logging.writers = [{"type": "stdout", "format": "pretty"}]
