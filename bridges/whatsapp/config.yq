.homeserver.address = "http://synapse:8008" |
.homeserver.domain = "hub.home.arpa" |
.appservice.address = "http://whatsapp:29318" |
.appservice.hostname = "0.0.0.0" |
.appservice.port = 29318 |
.appservice.id = "whatsapp" |
.appservice.bot.username = "whatsappbot" |
.appservice.bot.displayname = "WhatsApp bridge" |
.appservice.bot.avatar = "mxc://hub.home.arpa/ymqSNwrSCjRjfHXpixyiWCll" |
.appservice.username_template = "whatsapp_{{.}}" |
.database.type = "postgres" |
.database.uri = strenv(DB_URI) |
.bridge.permissions = {"hub.home.arpa": "user", "@piadmin:hub.home.arpa": "admin"} |
.bridge.personal_filtering_spaces = true |
.matrix.federate_rooms = false |
.backfill.enabled = true |
.backfill.max_initial_messages = 50 |
.backfill.max_catchup_messages = 500 |
.double_puppet.servers = {} |
.double_puppet.secrets = {"hub.home.arpa": "as_token:" + strenv(DP_TOKEN)} |
.encryption.allow = false |
.logging.min_level = "info" |
.logging.writers = [{"type": "stdout", "format": "pretty"}] |
.network.displayname_template = "{{or .FullName .BusinessName .PushName .Phone \"Unknown user\"}} (WA)" |
.network.history_sync.request_full_sync = false
